{
  "info": {
    "name": "Assignment 5 - Sequelize",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Signup User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User One\",\n  \"email\": \"user1@gmail.com\",\n  \"password\": \"1234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create Or Update User (Upsert)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"email\": \"Updated Last Name\",\n  \"age\": 30,\n  \"role\": \"user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get User By Email",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/by-email?email=user1@gmail.com",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "by-email"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "user1@gmail.com"
                }
              ]
            }
          }
        },
        {
          "name": "Get User By Id (Without Role)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"First Post\",\n  \"content\": \"This is the content of the first post.\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Post (Owner Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get All Posts With User And Comments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/details",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "details"
              ]
            }
          }
        },
        {
          "name": "Get All Posts With Comment Count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/comment-count",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "comment-count"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create Bulk Comments",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comments\": [\n    {\n      \"content\": \"This is the first comment.\",\n      \"postId\": 1,\n      \"userId\": 1\n    },\n    {\n      \"content\": \"Amazing post!\",\n      \"postId\": 1,\n      \"userId\": 2\n    },\n    {\n      \"content\": \"I totally agree with this post.\",\n      \"postId\": 2,\n      \"userId\": 3\n    },\n    {\n      \"content\": \"Thanks for sharing your thoughts.\",\n      \"postId\": 3,\n      \"userId\": 1\n    },\n    {\n      \"content\": \"Looking forward to more posts like this!\",\n      \"postId\": 1,\n      \"userId\": 4\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update Comment (Owner Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comments/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 3,\n  \"content\": \"updated\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Find Or Create Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comments/find-or-create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "find-or-create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postId\": 1,\n  \"userId\": 2,\n  \"content\": \"This is a sample comment\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Search Comments By Word",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comments/search?word=the",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "search"
              ],
              "query": [
                {
                  "key": "word",
                  "value": "the"
                }
              ]
            }
          }
        },
        {
          "name": "Get 3 Newest Comments Of Post",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comments/newest/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "newest",
                "1"
              ]
            }
          }
        },
        {
          "name": "Get Comment Details With User And Post",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comments/details/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "details",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}